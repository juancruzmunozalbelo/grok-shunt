{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "../scripts/install-user-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|Read|run_terminal_command|Bash|grep|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "check-read.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
